# Desarrollo local (valores publicos de ejemplo, nunca usar en produccion).
# Copiar a .env. En Windows COMPOSE_FILE separa archivos con ; y en Linux con :.
COMPOSE_PROJECT_NAME=generador-tickets-integrado
COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml
PLANE_DOMAIN=localhost
TICKETS_DOMAIN=tickets.localhost
WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5179,http://host.docker.internal:3000
PLANE_WEB_URL=http://host.docker.internal:3000
TICKETS_PUBLIC_URL=http://localhost:5179
SESSION_COOKIE_SECURE=false
POSTGRES_PASSWORD=plane-local-dev
RABBITMQ_PASSWORD=plane-local-dev
AWS_ACCESS_KEY_ID=plane-storage
AWS_SECRET_ACCESS_KEY=plane-storage-local-dev
SECRET_KEY=local-dev-django-secret-change-in-production
LIVE_SERVER_SECRET_KEY=local-dev-live-secret-change-in-production
SESSION_SECRET=local-dev-session-secret-change-in-production
PLANE_WORKSPACE_SLUG=crs
# Reemplazar por un token emitido por ESTA instancia para crear tickets.
PLANE_MCP_API_KEY=BOOTSTRAP_NOT_A_REAL_TOKEN

# Dokploy: usar SOLO docker-compose.yml, sin COMPOSE_FILE ni este override.
# Definir PLANE_DOMAIN/TICKETS_DOMAIN con los hosts reales, sin esquema ni ruta.
# Generar secretos propios para POSTGRES_PASSWORD, RABBITMQ_PASSWORD,
# AWS_SECRET_ACCESS_KEY, SECRET_KEY, LIVE_SERVER_SECRET_KEY y SESSION_SECRET.
# Passwords DB/MQ: usar hexadecimal para evitar caracteres reservados en URLs.
# Omitir WEB_URL/CORS_ALLOWED_ORIGINS/PLANE_WEB_URL/TICKETS_PUBLIC_URL
# para derivarlos de los dominios con HTTPS; SESSION_COOKIE_SECURE=true.
# Conservar credenciales existentes al reutilizar volumenes.
# Opcionales:
# CURSOR_API_KEY=
# LLM_MODEL=auto
# ROUTER_PREFIX=crs-tickets
