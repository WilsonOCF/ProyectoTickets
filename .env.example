# =============================================================================
# Stack unificado — GeneradorDeTicketsIntegrado
# Copia a `.env` y completa valores. Nunca subas el `.env` real al repo.
#
# Regla de IPs/hostnames:
#   - Dentro de Docker: usa nombres de servicio (api, plane-mcp, floci, …)
#   - En el navegador del usuario: usa tu dominio público HTTPS (Dokploy)
#   - NUNCA pongas localhost / 127.0.0.1 en variables de contenedores en prod
#     (nuevo-ticket lo rechaza en NODE_ENV=production)
# =============================================================================

# -----------------------------------------------------------------------------
# Dominio público de Plane (lo que ve el usuario / CORS / redirects)
# En Dokploy: el dominio apuntado al servicio `proxy`
# -----------------------------------------------------------------------------
APP_DOMAIN=plane.example.com
WEB_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com,https://tickets.example.com
APP_RELEASE=stable

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=
CERT_ACME_DNS=

# -----------------------------------------------------------------------------
# Secretos Plane (OBLIGATORIO cambiar en producción)
# openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=change-this-django-secret-on-deployment
LIVE_SERVER_SECRET_KEY=change-this-live-secret-on-deployment
DEBUG=0

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=plane
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGHOST=plane-db
PGDATABASE=plane
PGDATA=/var/lib/postgresql/data
# Si lo dejas vacío, el compose usa el default con user/pass/host de arriba
DATABASE_URL=postgresql://plane:change-me-strong-db-password@plane-db:5432/plane

# -----------------------------------------------------------------------------
# Redis / RabbitMQ
# -----------------------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me-strong-mq-password
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:change-me-strong-mq-password@plane-mq:5672/plane

# -----------------------------------------------------------------------------
# MinIO de Plane (adjuntos nativos de Plane — distinto de Floci)
# -----------------------------------------------------------------------------
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute
GUNICORN_WORKERS=1
API_BASE_URL=http://api:8000

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# plane-mcp (servicio Compose: plane-mcp)
# -----------------------------------------------------------------------------
# URL que el MCP usa hacia Plane. Preferible red interna:
PLANE_BASE_URL=http://api:8000
PLANE_INTERNAL_BASE_URL=http://api:8000
MCP_HOST_PORT=8211
MCP_LOG_LEVEL=info
MCP_LOG_PAYLOADS=false
# Opcional: forzar imagen prebuild
# PLANE_MCP_IMAGE=generador-tickets/plane-mcp:local

# -----------------------------------------------------------------------------
# floci-tickets / Nuevo Ticket (servicio Compose: floci-tickets)
# -----------------------------------------------------------------------------
TICKETS_HOST_PORT=5179
# Mínimo 32 caracteres aleatorios
SESSION_SECRET=change-me-to-a-long-random-session-secret-32plus

# Interno (red Docker) — valores por defecto del compose ya apuntan a api/plane-mcp/floci
PLANE_API_URL=http://api:8000
# Público — URL de Plane en el navegador (enlaces en tickets). Puede ser localhost en local.
PLANE_WEB_URL=https://plane.example.com
TICKETS_PUBLIC_URL=https://tickets.example.com
SESSION_COOKIE_SECURE=true
PLANE_WORKSPACE_SLUG=crs
# Interno MCP (path del Dockerfile custom)
PLANE_MCP_URL=http://plane-mcp:8211/http/api-key/mcp
# API key de un usuario Plane con permisos para crear issues/adjuntos
PLANE_MCP_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

FLOCI_BUCKET=tickets
FLOCI_AWS_REGION=us-east-1
# Credenciales ficticias típicas de Floci local
FLOCI_AWS_ACCESS_KEY_ID=test
FLOCI_AWS_SECRET_ACCESS_KEY=test

# Análisis LLM opcional (si vacío, plantilla local)
CURSOR_API_KEY=
LLM_MODEL=auto

# Opcional: forzar imagen prebuild
# FLOCI_TICKETS_IMAGE=generador-tickets/floci-tickets:local
