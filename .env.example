# Valores ilustrativos; sustituir TODOS los REPLACE antes de desplegar.
# Dominios propuestos pendientes de DNS. infra.crs-logistics.com es Dokploy.
PLANE_DOMAIN=plane.crs-logistics.com
TICKETS_DOMAIN=tickets.crs-logistics.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX
RABBITMQ_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
AWS_ACCESS_KEY_ID=plane-storage
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
LIVE_SERVER_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
PLANE_WORKSPACE_SLUG=crs
PLANE_MCP_API_KEY=REPLACE_WITH_TOKEN_FROM_TARGET_PLANE

# Opcionales: sin CURSOR_API_KEY se usa la plantilla local.
# CURSOR_API_KEY=
# LLM_MODEL=auto
# ROUTER_PREFIX=crs-tickets
