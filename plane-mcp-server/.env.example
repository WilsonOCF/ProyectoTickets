# Variables del contenedor Dockerfile. Completar en Environment de Dokploy.
# Obligatoria: URL de Plane accesible desde el contenedor, sin /api/v1.
PLANE_BASE_URL=https://plane.example.com

# Opcional: URL interna de Plane; reemplaza la anterior en llamadas API.
# PLANE_INTERNAL_BASE_URL=http://plane-api:8000

# Valores predeterminados del Dockerfile. PORT debe coincidir con Dokploy.
HOST=0.0.0.0
PORT=8211
LOG_LEVEL=info
# false evita registrar el contenido de los tickets en el middleware MCP.
LOG_PAYLOADS=false

# No se requieren Redis, Valkey, claves LLM ni variables OAuth.
# El CLIENTE (la web) configura MCP_SERVER_URL y envia por peticion:
# Authorization: Bearer <token-de-Plane>
# X-Workspace-slug: <workspace>
# No pegues tokens reales en este archivo.
