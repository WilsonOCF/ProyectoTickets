# Ejemplo sin credenciales. Copiar a .env para uso local.
# En Dokploy usar Environment; nunca subir el .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=5179
# Secreto aleatorio de al menos 32 caracteres.
SESSION_SECRET=
TICKETS_REGISTRATION_ENABLED=true
# En el Compose raiz se configura automáticamente el bridge privado y su secreto.
PLANE_BRIDGE_URL=http://plane-ticket-bridge:8220
# TICKETS_BRIDGE_SECRET= (si se omite, usa SESSION_SECRET)
# TICKETS_DATABASE_PATH= (por defecto ./data/portal.sqlite; volumen en Docker)

# Servidor: direcciones accesibles desde Docker, sin localhost.
# PLANE_WEB_URL debe abrirse tambi?n en el navegador del usuario.
PLANE_API_URL=http://localhost:3000
PLANE_WEB_URL=http://localhost:3000
PLANE_WORKSPACE_SLUG=
PLANE_MCP_URL=http://127.0.0.1:8211/mcp
PLANE_MCP_API_KEY=

# Compose de Dokploy usa http://floci:4566 autom?ticamente.
FLOCI_ENDPOINT=http://127.0.0.1:4566
FLOCI_BUCKET=tickets
AWS_REGION=us-east-1
# Solo Floci utiliza credenciales ficticias test/test.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Opcional: sin clave funciona con plantilla local, sin IA.
CURSOR_API_KEY=
LLM_MODEL=auto
# Vac?o: detecci?n autom?tica. Docker ya configura Python de Linux.
CURSOR_PYTHON=
# Pruebas manuales: no se ejecutan en el despliegue.
TEST_BASE_URL=http://127.0.0.1:5179
TEST_PLANE_EMAIL=
TEST_PLANE_PASSWORD=
